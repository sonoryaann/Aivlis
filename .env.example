# Ottieni una API key gratuita su https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opzionale, per la classifica/attribuzione lato OpenRouter
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Aivlis

# Ottieni una API key gratuita (nessuna carta richiesta) su https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Porta del server locale
PORT=3000

# Lista di modelli da interrogare in parallelo (uno per "pagina" di risultato).
# Ogni voce è "provider:model-id" — provider è "openrouter" oppure "groq".
# OpenRouter è il pool primario: verifica la disponibilità aggiornata su
# https://openrouter.ai/models?max_price=0 (account gratuito = 50 richieste/giorno su tutti i
# modelli combinati; con $10 di credito una tantum, mai spesi finché usi solo modelli ":free",
# il tetto sale a 1000/giorno — vedi README).
# I modelli non disponibili vengono comunque tentati, ma potrebbero fallire: in quel caso il
# risultato corrispondente viene semplicemente scartato (o recuperato da FALLBACK_MODELS).
MODELS=openrouter:inclusionai/ling-3.0-flash-sante:free,openrouter:inclusionai/ling-3.0-flash-fin:free,openrouter:liquid/lfm-2.5-2.6b:free,openrouter:stealth/space-bunny-alpha,openrouter:nvidia/nemotron-3-super-120b-a12b:free,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free

# Modelli di riserva: se un modello primario fallisce (rate limit, timeout, formato errato),
# il server ne pesca uno da qui (al massimo una volta per pagina) per provare a recuperare il risultato.
# Groq per primo: scatta subito se OpenRouter ha problemi, ed è molto più veloce (verifica i
# modelli disponibili sulla tua chiave su https://console.groq.com/docs/models, il catalogo
# cambia spesso).
FALLBACK_MODELS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,openrouter:poolside/laguna-xs-2.1:free,openrouter:qwen/qwen3.8-27b:free

# Modello per la tab "Immagini" (endpoint OpenRouter dedicato /api/v1/images, non il solito
# chat/completions). Costo reale $0/immagine, ma l'endpoint immagini richiede comunque un
# limite di spesa > $0 impostato sulla chiave OpenRouter (Settings > Keys, anche solo $1: non
# verrà mai speso restando su modelli a costo $0, vedi README).
IMAGE_MODEL=inclusionai/ming-image-0.1-design

# Modello/i per la chat "Ask Silvy" (stesso formato provider:model-id, lista separata da virgole
# per un fallback in sequenza se il primo fallisce). Priorità alla velocità: è una chat, deve
# rispondere in fretta.
SILVY_MODEL=groq:openai/gpt-oss-120b,openrouter:inclusionai/ling-3.0-flash-sante:free
